# Kopieren nach .env (wird NICHT versioniert) und ausfüllen.
ZEITZONE=Europe/Berlin

# --- Push aufs Handy (App "ntfy" aus Play Store/App Store, Topic abonnieren) ---
# Topic = wie ein Passwort: lang und zufällig wählen, z. B. Ausgabe von: python3 -c "import secrets;print('tiep-'+secrets.token_urlsafe(12))"
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Google-Kalender (Service-Account, siehe README Schritt 3) ---
GOOGLE_SA_DATEI=/home/pi/.config/tagesimpuls/service-account.json
# Kalender, deren Termine erinnert werden (Komma-getrennt). Erster = Ziel für Finanz-Termine.
KALENDER_IDS=vuxuantiep@googlemail.com
# Optional: eigener Kalender "Tagesimpuls" (Kalender-ID aus Einstellungen > Kalender integrieren)
IMPULS_KALENDER_ID=

# --- Wecker ---
# Vorlauf in Minuten für Termine mit Standard-Erinnerung
WECKER_STANDARD_MIN=30,10
# Diese Wörter im Titel (oder Farbe "Tomate") machen einen Termin zum lauten Wecker
ALARM_WOERTER=⏰,wecker,alarm,!!
# Ton direkt am Pi (Lautsprecher an Klinke/USB/HDMI), 1 = an
TON_AUF_PI=0
TON_WIEDERHOLUNGEN=3

# --- Finanzen ---
WISO_URL=https://www.wiso.de
ELSTER_URL=https://www.elster.de
# Direkter Link zur Excel in Google Drive (Datei öffnen > Teilen > Link kopieren)
FINANZPLAN_URL=https://drive.google.com/drive/search?q=Finanzplan
